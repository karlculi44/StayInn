NODE_ENV=development
PORT=5000
HOST=127.0.0.1
FRONTEND_URL=http://localhost:5173
# For LAN testing only, bind the backend to network interfaces. The Vite proxy
# keeps the browser same-origin, so LAN_FRONTEND_URL is not needed for that flow.
# HOST=0.0.0.0
# LAN_FRONTEND_URL=http://stayinn-pc.office.example:5173
PROFILE_IMAGE_UPLOAD_DIR=uploads/profile-images
PROFILE_IMAGE_MAX_SIZE_MB=5
DATABASE_URL=postgresql://local_user:replace-me@localhost:5432/stayinn_dev
TEST_DATABASE_URL=postgresql://local_user:replace-me@localhost:5432/stayinn_test
JWT_ACCESS_TOKEN_SECRET=replace-with-a-random-local-only-access-secret
JWT_REFRESH_TOKEN_SECRET=replace-with-a-different-local-only-refresh-secret
