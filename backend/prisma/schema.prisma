generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid())
  firstName      String
  lastName       String
  email          String   @unique
  password       String
  profilePicture String?
  role           Role     @default(GUEST)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reservations           Reservation[]
  refreshTokens          RefreshToken[]
  roomStatusChanges      RoomStatusHistory[]     @relation("RoomStatusChangedBy")
  notificationRecipients NotificationRecipient[]
  reservationHistory     ReservationHistory[]    @relation("ReservationHistoryActor")
  reservationRequests    ReservationRequest[]    @relation("ReservationRequestGuest")
  reviewedRequests       ReservationRequest[]    @relation("ReservationRequestReviewer")
}

enum Role {
  GUEST
  ADMIN
}

model RoomType {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String
  capacity      Int
  pricePerNight Decimal
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rooms Room[]
}

model Room {
  id         String     @id @default(uuid())
  roomNumber String     @unique
  status     RoomStatus @default(AVAILABLE)

  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservations  Reservation[]
  statusHistory RoomStatusHistory[]
}

enum RoomStatus {
  AVAILABLE
  MAINTENANCE
  INACTIVE
}

model RoomStatusHistory {
  id             String     @id @default(uuid())
  previousStatus RoomStatus
  newStatus      RoomStatus
  reason         String
  createdAt      DateTime   @default(now())

  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: SetNull)

  adminId String?
  admin   User?   @relation("RoomStatusChangedBy", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([roomId, createdAt])
  @@index([adminId, createdAt])
}

model Reservation {
  id          String            @id @default(uuid())
  referenceId String            @unique
  checkIn     DateTime
  checkOut    DateTime
  guests      Int
  totalAmount Decimal
  status      ReservationStatus @default(PENDING)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  roomId String
  room   Room   @relation(fields: [roomId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history  ReservationHistory[]
  requests ReservationRequest[]
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model ReservationHistory {
  id            String                       @id @default(uuid())
  reservationId String
  reservation   Reservation                  @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  actorId       String?
  actor         User?                        @relation("ReservationHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  action        ReservationHistoryAction
  description   String
  oldValues     Json?
  newValues     Json?
  visibility    ReservationHistoryVisibility @default(GUEST_VISIBLE)
  createdAt     DateTime                     @default(now())

  @@index([reservationId, createdAt])
  @@index([reservationId, visibility, createdAt])
  @@index([actorId, createdAt])
}

enum ReservationHistoryAction {
  CREATED
  CONFIRMED
  CANCELLED
  UPDATED
  COMPLETED
  EDIT_REQUESTED
  EDIT_APPROVED
  EDIT_REJECTED
  CANCELLATION_REQUESTED
  CANCELLATION_APPROVED
  CANCELLATION_REJECTED
}

enum ReservationHistoryVisibility {
  ADMIN_ONLY
  GUEST_VISIBLE
}

model Notification {
  id            String                     @id @default(uuid())
  type          NotificationType
  title         String
  message       String
  referenceId   String?
  referenceType NotificationReferenceType?
  createdAt     DateTime                   @default(now())
  recipients    NotificationRecipient[]

  @@index([createdAt])
  @@index([referenceType, referenceId])
}

model NotificationRecipient {
  id             String       @id @default(uuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRead         Boolean      @default(false)
  readAt         DateTime?

  @@unique([notificationId, userId])
  @@index([userId, isRead])
}

enum NotificationType {
  RESERVATION_STATUS_UPDATED
  NEW_RESERVATION
  RESERVATION_REQUEST_SUBMITTED
  RESERVATION_REQUEST_REVIEWED
}

enum NotificationReferenceType {
  RESERVATION
}

model ReservationRequest {
  id              String                   @id @default(uuid())
  reservationId   String
  reservation     Reservation              @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  guestId         String?
  guest           User?                    @relation("ReservationRequestGuest", fields: [guestId], references: [id], onDelete: SetNull)
  type            ReservationRequestType
  status          ReservationRequestStatus @default(PENDING)
  reason          String
  originalValues  Json
  proposedChanges Json?
  reviewedBy      String?
  reviewer        User?                    @relation("ReservationRequestReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewReason    String?
  reviewedAt      DateTime?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([reservationId, createdAt])
  @@index([guestId, status])
  @@index([status, createdAt])
}

enum ReservationRequestType {
  EDIT
  CANCELLATION
}

enum ReservationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
